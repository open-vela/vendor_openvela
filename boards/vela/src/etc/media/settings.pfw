domain: MediaSwitchDomain
    conf: a2dp
        AvailableDevices Includes a2dp
        FFmpegCommand = Music,map,0 1;Ring,map,0 1;Alarm,map,1 1;Notify,map,0 1;Sport,map,0 1;Video,map,0 1;
    conf: speaker
        ALL
        FFmpegCommand = Music,map,1 0;Ring,map,1 0;Alarm,map,1 0;Notify,map,1 0;Sport,map,1 0;Video,map,1 0;a2dpsrc,unlink,;

domain: netcommDomain
    conf: netcomm-sco
        ALL
            AudioMode        Is       normal
            AvailableDevices Includes digital
            AvailableDevices Includes sco
            UsingDevices     Includes sco
        FFmpegCommand = netcomm,map,0 1;
    conf: netcomm
        ALL
        FFmpegCommand = netcomm,map,1 0;

domain: pcm0cDomain
    conf: sco
        ALL
            MicMode          Is       on
            AudioMode        Is       phone
            AvailableDevices Excludes modem
            AvailableDevices Excludes digital
            AvailableDevices Excludes wtp
            AvailableDevices Includes sco
            UsingDevices     Includes sco
        FFmpegCommand = pcm0c,unmute,;pcm0c,sample_rate,%HFPSampleRate%;pcm0c,map,0 1 0 0;pcm0c,link,;
    conf: sco-mute
        ALL
            MicMode          Is       off
            AudioMode        Is       phone
            AvailableDevices Excludes modem
            AvailableDevices Excludes digital
            AvailableDevices Excludes wtp
            AvailableDevices Includes sco
            UsingDevices     Includes sco
        FFmpegCommand = pcm0c,mute,;
    conf: btcomm/modem
        ALL
            MicMode          Is       on
            AudioMode        Is       phone
            ANY
                AvailableDevices Includes modem
                AvailableDevices Includes digital
            UsingDevices         Excludes sco
        FFmpegCommand = pcm0c,unmute,;pcm0c,sample_rate,%HFPSampleRate%;pcm0c,map,0 0 1 0;pcm0c,link,;
    conf: wtpcomm
        ALL
            MicMode          Is       on
            AudioMode        Is       phone
            AvailableDevices Includes wtp
            UsingDevices     Excludes sco
        FFmpegCommand = pcm0c,unmute,;pcm0c,sample_rate,%HFPSampleRate%;pcm0c,map,0 0 0 1;pcm0c,link,;
    conf: netcomm
        ALL
            MicMode          Is       on
            AvailableDevices Includes digital
            UsingDevices     Excludes sco
        FFmpegCommand = pcm0c,unmute,;pcm0c,map,1 0 0 0;
    conf: cap
        MicMode          Is       on
        FFmpegCommand = pcm0c,unmute,;pcm0c,map,1 0 0 0;pcm0c,link,;
    conf: off
        ALL
        FFmpegCommand = pcm0c,unmute,;pcm0c,map,0 0 0 0;pcm0c,unlink,;

domain: SCOrxDomain
    conf: sco
        ALL
            AudioMode        Is       phone
            AvailableDevices Excludes modem
            AvailableDevices Excludes digital
            AvailableDevices Excludes wtp
            AvailableDevices Includes sco
            UsingDevices     Includes sco
        FFmpegCommand = SCOrx,unmute,;SCOrx,sample_rate,%HFPSampleRate%;SCOrx,map,1 0 0 0;SCOrx,link,;
    conf: btcomm/modem-sco
        ALL
            MicMode          Is       on
            AudioMode        Is       phone
            ANY
                AvailableDevices Includes modem
                AvailableDevices Includes digital
            AvailableDevices     Includes sco
            UsingDevices         Includes sco
        FFmpegCommand = SCOrx,unmute,;SCOrx,sample_rate,%HFPSampleRate%;SCOrx,map,0 1 0 0;SCOrx,link,;
    conf: btcomm/modem-sco-mute
        ALL
            MicMode          Is       off
            AudioMode        Is       phone
            ANY
                AvailableDevices Includes modem
                AvailableDevices Includes digital
            AvailableDevices     Includes sco
            UsingDevices         Includes sco
        FFmpegCommand = SCOrx,mute,;
    conf: netcomm-sco
        ALL
            AudioMode        Is       normal
            AvailableDevices Includes digital
            AvailableDevices Includes sco
            UsingDevices     Includes sco
        FFmpegCommand = SCOrx,unmute,;SCOrx,sample_rate,%HFPSampleRate%;SCOrx,map,0 0 1 0;SCOrx,link,;
    conf: wtpcomm-sco
        ALL
            AudioMode        Is       phone
            AvailableDevices Includes wtp
            AvailableDevices Includes sco
            UsingDevices     Includes sco
        FFmpegCommand = SCOrx,unmute,;SCOrx,sample_rate,%HFPSampleRate%;SCOrx,map,0 0 0 1;SCOrx,link,;
    conf: off
        ALL
        FFmpegCommand = SCOrx,unmute,;SCOrx,map,0 0 0 0;SCOrx,unlink,;

domain: MDMrxDomain
    conf: btcomm/modem
        ALL
            AudioMode        Is       phone
            ANY
                AvailableDevices Includes modem
                AvailableDevices Includes digital
            UsingDevices         Excludes sco
        FFmpegCommand = MDMrx,map,1 0;MDMrx,link,;
    conf: ringtone-modem
        ALL
            AudioMode        Is       ringtone
            AvailableDevices Includes modem
        FFmpegCommand = MDMrx,map,1 0;MDMrx,link,;
    conf: btcomm/modem-sco
        ALL
            AudioMode        Is       phone
            ANY
                AvailableDevices Includes modem
                AvailableDevices Includes digital
            AvailableDevices     Includes sco
            UsingDevices         Includes sco
        FFmpegCommand = MDMrx,map,0 1;MDMrx,link,;
    conf: off
        ALL
        FFmpegCommand = MDMrx,map,0 0;MDMrx,unlink,;

domain: pcm0pParamDomain
    conf: modem
        ALL
            AudioMode        Is       phone
            AvailableDevices Includes modem
            UsingDevices     Excludes sco
        FFmpegCommand = pcm0p,set_parameter,set_scenario=modem;
    conf: btcomm
        ALL
            AudioMode        Is       phone
            AvailableDevices Includes digital
            UsingDevices     Excludes sco
        FFmpegCommand = pcm0p,set_parameter,set_scenario=btTalk;
    conf: netcomm
        ALL
            AvailableDevices Includes digital
            UsingDevices     Excludes sco
        FFmpegCommand = pcm0p,set_parameter,set_scenario=netTalk;
    conf: sco
        ALL
            AvailableDevices Excludes modem
            AvailableDevices Excludes digital
            UsingDevices     Includes sco
            AvailableDevices Includes sco
        FFmpegCommand = pcm0p,set_parameter,set_scenario=sco;
    conf: play
        ALL
        FFmpegCommand = pcm0p,set_parameter,set_scenario=music;

domain: MediaVolumeDomain
    conf: mute
        persist.media.MediaVolume In 0
        FFmpegCommand = Music,volume,0;
    conf: 1
        persist.media.MediaVolume In 1
        FFmpegCommand = Music,volume,-41dB;
    conf: 2
        persist.media.MediaVolume In 2
        FFmpegCommand = Music,volume,-36dB;
    conf: 3
        persist.media.MediaVolume In 3
        FFmpegCommand = Music,volume,-30dB;
    conf: 4
        persist.media.MediaVolume In 4
        FFmpegCommand = Music,volume,-25dB;
    conf: 5
        persist.media.MediaVolume In 5
        FFmpegCommand = Music,volume,-22dB;
    conf: 6
        persist.media.MediaVolume In 6
        FFmpegCommand = Music,volume,-19dB;
    conf: 7
        persist.media.MediaVolume In 7
        FFmpegCommand = Music,volume,-16dB;
    conf: 8
        persist.media.MediaVolume In 8
        FFmpegCommand = Music,volume,-11dB;
    conf: 9
        persist.media.MediaVolume In 9
        FFmpegCommand = Music,volume,-5dB;
    conf: 10
        persist.media.MediaVolume In 10
        FFmpegCommand = Music,volume,1;

domain: RingVolumeDomain
    conf: mute
        ANY
            MuteMode   Is on
            RingVolume In 0
        FFmpegCommand = Ring,volume,0;
    conf: index-%RingVolume
        RingVolume In [1,9]
        FFmpegCommand = Ring,volume,10^(-4*(10-%RingVolume%)/20);
    conf: 10
        RingVolume In 10
        FFmpegCommand = Ring,volume,1;

domain: AlarmVolumeDomain
    conf: mute
        AlarmVolume In 0
        FFmpegCommand = Alarm,volume,0;
    conf: index-%AlarmVolume
        AlarmVolume In [1,9]
        FFmpegCommand = Alarm,volume,10^(-4*(10-%AlarmVolume%)/20);
    conf: 10
        AlarmVolume In 10
        FFmpegCommand = Alarm,volume,1;

