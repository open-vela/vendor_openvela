domain: NetcommVolumeDomain
    conf: mute
        ALL
            AudioMode          IsNot       phone
            AvailableDevices Includes digital
            MusicVolume      In       0
        FFmpegCommand = Netcomm,volume,0;
    conf: index-%MusicVolume
        ALL
            AudioMode          IsNot       phone
            AvailableDevices Includes digital
            MusicVolume      In       [1,9]
        FFmpegCommand = Netcomm,volume,10^(-4*(10-%MusicVolume%)/20);
    conf: 10
        ALL
            AudioMode          IsNot       phone
            AvailableDevices Includes digital
            MusicVolume      In       10
        FFmpegCommand = Netcomm,volume,1;

