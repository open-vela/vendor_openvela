      "pages/weather/forecast": {
        "component": "index"
      },
      "pages/dialogue": {
        "component": "index"
      },
      "pages/translation": {
        "component": "index"
      },
      "pages/poem": {
        "component": "index"
      },
      "pages/entry": {
        "component": "index"
      },
      "pages/mesh/home": {
        "component": "index",
