{
  "package": "com.application.x4b.voicepage",
  "name": "voicepage",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "display": {
    "backgroundColor": "#000000"
  },
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.router"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "service.internal.micoaudio"
    },
    {
      "name": "system.internal.miai"
    },
    {
      "name": "system.internal.mesh"
    },
    {
      "name": "service.mihome"
    },
    {
      "name": "system.wifi"
    }
