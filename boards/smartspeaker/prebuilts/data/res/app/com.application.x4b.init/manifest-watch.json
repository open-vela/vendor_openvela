{
  "package": "com.application.x4b.init",
  "name": "init",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "intent-filter": {
    "actions": [
      "action.system.BOOT_GUIDE"
    ]
  },
  "features": [
    {
      "name": "system.router"
    },
    {
      "name": "system.wifi"
    },
    {
      "name": "system.internal.ota"
    },
    {
      "name": "system.exchange"
    },
    {
      "name": "system.internal.power"
    },
    {
      "name": "service.bootstrap"
    },
    {
      "name": "service.internal.account"
    },
    {
      "name": "service.internal.micoaudio"
    },
    {
      "name": "system.internal.settings"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 800,
    "imageCache": 1048576
  },
  "display": {
    "backgroundColor": "#000000",
    "textColor": "#ffffff"
  },
  "router": {
    "entry": "pages/start",
    "pages": {
      "pages/start": {
        "component": "index"
      },
      "pages/start/user": {
        "component": "index"
      },
      "pages/start/privacy": {
        "component": "index"
      },
      "pages/network": {
        "component": "index"
      },
      "pages/network/reboot": {
        "component": "index"
      },
      "pages/network/timeout": {
        "component": "index"
      },
      "pages/network/detail": {
        "component": "index"
      },
      "pages/network/security": {
        "component": "index"
      },
      "pages/login/download": {
        "component": "index"
      },
      "pages/login/activate": {
        "component": "index"
      },
      "pages/login/fail": {
        "component": "index"
      },
      "pages/login/different": {
        "component": "index"
      },
      "pages/account": {
        "component": "index"
      },
      "pages/account/change": {
        "component": "index"
      }
    }
  }
}