{
  "package": "com.application.x4b.launcher",
  "priority": "persistent",
  "intent-filter": {
    "actions": [
      "action.system.HOME"
    ]
  },
  "name": "launcher",
  "versionName": "1.0.3",
  "versionCode": 3,
  "minPlatformVersion": 1000,
  "icon": "/common/images/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.router"
    },
    {
      "name": "system.storage"
    },
    {
      "name": "system.request"
    },
    {
      "name": "system.folme"
    },
    {
      "name": "system.serviceUtil"
    },
    {
      "name": "service.internal.micoaudio"
    },
    {
      "name": "service.internal.account"
    },
    {
      "name": "service.mihome"
    },
    {
      "name": "service.internal.audiosync"
    },
    {
      "name": "service.internal.audiofocus"
    },
    {
      "name": "system.internal.alarm"
    },
    {
      "name": "system.prompt"
    },
    {
      "name": "system.internal.miai"
    },
    {
      "name": "system.internal.settings"
    },
    {
      "name": "system.microphone"
    },
    {
      "name": "system.wifi"
    },
    {
      "name": "system.exchange"
    },
    {
      "name": "system.messageChannel"
    },
    {
      "name": "service.internal.miot"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 800,
    "imageCache": 2097152
  },
  "display": {
    "backgroundColor": "#000000"
  },
  "router": {
    "entry": "pages/home",
    "pages": {
      "pages/home": {
        "component": "index",
        "launchMode": "singleTask"
      },
      "pages/edit": {
        "component": "index",
        "launchMode": "singleTask"
      },
      "pages/detail": {
        "component": "index"
      },
      "pages/add": {
        "component": "index"
      }
    }
  }
}