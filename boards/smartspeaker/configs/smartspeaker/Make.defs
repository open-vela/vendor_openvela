include ${TOPDIR}/.config

include ${TOPDIR}/tools/Config.mk
include $(BOARD_DIR)/scripts/Make.defs

define POSTBUILD
    $(Q)echo "Generating: vela_ap.bin"; \
    cp nuttx vela_ap.elf;
    cp nuttx.bin vela_ap.bin;
    cp nuttx.map vela_ap.map;

    $(Q)echo "Generating: vela_system.bin";
    $(Q)genromfs -f ${TOPDIR}/vela_system.bin -d $(BOARD_DIR)/prebuilts/data/res;

    $(Q)echo "Generating initial vela_data.bin";
    $(Q)mkdir -p ${BOARD_DIR}/prebuilts/image;
    $(Q)dd if=/dev/zero of=${BOARD_DIR}/prebuilts/image/vela_data.bin bs=1M count=120;
    $(Q)mkfs.fat ${BOARD_DIR}/prebuilts/image/vela_data.bin;
    $(Q)mcopy -i ${BOARD_DIR}/prebuilts/image/vela_data.bin -sv $(BOARD_DIR)/prebuilts/data/UDISK/* :: > /dev/null 2>&1;
endef
