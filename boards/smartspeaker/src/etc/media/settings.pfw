domain: MicDomain
	conf: enable
		UsingDevices Includes mic
		FFmpegCommand = pcm10c,unmute;pcm11c,unmute;pcm12c,unmute;
	conf: disable
		ALL
		FFmpegCommand = pcm10c,mute;pcm11c,mute;pcm12c,mute;

domain: A2dpDomain
	conf: enable
		UsingDevices Includes a2dpsnk
		FFmpegCommand = a2dpsnk,start;
	conf: disable
		ALL
		FFmpegCommand = a2dpsnk,stop;

domain: A2dpsnkVolumeDomain
	conf: 0
		A2dpsnkVolume In 0
		FFmpegCommand = VolA2dpsnk,volume,0;pcm0p,set_parameter,-96;
	conf: index-%A2dpsnkVolume
		A2dpsnkVolume In [1,9]
		FFmpegCommand = VolA2dpsnk,volume,10^(-4*(10-%A2dpsnkVolume%)/20);pcm0p,set_parameter,4 %A2dpsnkVolume%;
	conf: 10
		A2dpsnkVolume In 10
		FFmpegCommand = VolA2dpsnk,volume,1;pcm0p,set_parameter,0;

domain: RingVolumeDomain
	conf: 0
		RingVolume In 0
		FFmpegCommand = VolRing,volume,0;pcm0p,set_parameter,-96;
	conf: index-%RingVolume
		RingVolume In [1,9]
		FFmpegCommand = VolRing,volume,10^(-4*(10-%RingVolume%)/20);pcm0p,set_parameter,4 %RingVolume%;
	conf: 10
		RingVolume In 10
		FFmpegCommand = VolRing,volume,1;pcm0p,set_parameter,0;

