	conf: 10
		MediaVolume In 10
		FFmpegCommand = VolMedia,volume,1;pcm0p,set_parameter,0;

domain: AlarmVolumeDomain
	conf: 0
		AlarmVolume In 0
		FFmpegCommand = VolAlarm,volume,0;pcm0p,set_parameter,-96;
	conf: index-%AlarmVolume
		AlarmVolume In [1,9]
		FFmpegCommand = VolAlarm,volume,10^(-4*(10-%AlarmVolume%)/20);pcm0p,set_parameter,4 %AlarmVolume%;
	conf: 10
		AlarmVolume In 10
		FFmpegCommand = VolAlarm,volume,1;pcm0p,set_parameter,0;
