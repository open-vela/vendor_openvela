#include <nuttx/config.h>

set +e

#include "rcS.first"

#ifdef CONFIG_KVDB
  kvdbd &
#endif

#ifdef CONFIG_ANDROID_SERVICEMANAGER
  servicemanager &
#endif

#ifdef CONFIG_SYSTEM_ADBD
  adbd &
#endif

#ifdef CONFIG_MEDIA_SERVER
  mediad &
#endif

mount -t hostfs -o fs=vendor/qemu/boards/smartspeaker/resource /host

#ifdef CONFIG_BT
if [ ! -d /data/factest ]; then
#ifdef CONFIG_MIBLE_MESH_COMMON
  zblue 0
#else
  zblue
#endif
else
  zblue
fi

#ifdef CONFIG_BT_TESTER
  bttester &
#endif /* CONFIG_BT_TESTER */

#endif /* CONFIG_BT */

#ifdef CONFIG_ENABLE_LAB_TEST_UTILS
  telnetd &
#endif /* CONFIG_ENABLE_LAB_TEST_UTILS */

if [ ! -d /data/nobusiness ];then

set_model

#ifdef CONFIG_SYSTEM_SERVER
  systemd &
#endif

fi

#ifdef CONFIG_OPTEE_OS
opteed &
#endif

#include "rcS.last"
