[open-vela]
config_base_path=vendor/openvela/boards/vela/configs
config_cmake_list=goldfish-armeabi-v7a-ap,goldfish-arm64-v8a-ap,goldfish-x86_64-ap
cmake_parallel=1

[open-smartspeaker]
config_base_path=vendor/openvela/boards/smartspeaker/configs
config_cmake_list=smartspeaker-knsh@cmake,smartspeaker@cmake
cmake_parallel=1
